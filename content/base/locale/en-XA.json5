  "event.diplomatic.border-incident.body": "⟦Hërdërs fröm ä nëïghböürïng rëälm ärë cäüght gräzïng ön dïspütëd länd. ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.diplomatic.border-incident.choice.apologize": "⟦Äpölögïzë änd lët ït gö ΞΞΞΞΞΞΞ⟧",
  "event.diplomatic.border-incident.choice.expel": "⟦Ëxpël thëm by förcë ΞΞΞΞΞΞ⟧",
  "event.diplomatic.royal-envoy.title": "⟦Röyäl Ënvöy ΞΞΞΞ⟧",
  "event.diplomatic.royal-envoy.body": "⟦Ä nëïghböürïng cöürt sënds än ënvöy bëärïng gïfts änd gööd wïll. ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.diplomatic.royal-envoy.choice.welcome": "⟦Wëlcömë thëm wärmly ΞΞΞΞΞΞ⟧",
  "event.diplomatic.royal-envoy.choice.cool-reception": "⟦Rëcëïvë thëm cöölly ΞΞΞΞΞΞ⟧",
  "event.diplomatic.trade-dispute.title": "⟦Trädë Dïspütë ΞΞΞΞ⟧",
  "event.diplomatic.trade-dispute.body": "⟦Nëïghböürïng mërchänts cömpläïn thë cörvéë lëvïës ärë dïsrüptïng trädë röütës. ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.diplomatic.trade-dispute.choice.concede": "⟦Hëär thëïr cömpläïnt öüt ΞΞΞΞΞΞΞΞ⟧",
  "event.diplomatic.trade-dispute.choice.dismiss": "⟦Dïsmïss thë cömpläïnt ΞΞΞΞΞΞΞ⟧",
  "event.disaster.blight.title": "⟦Cröp Blïght ΞΞΞΞ⟧",
  "event.disaster.blight.body": "⟦Ä füngäl blïght sprëäds thröügh thë fïëlds. Gräïn störës wïll süffër ëïthër wäy. ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.disaster.blight.choice.endure": "⟦Ëndürë ït — lët thë härvëst täkë thë löss ΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.disaster.blight.choice.burn-fields": "⟦Bürn thë äffëctëd fïëlds bëförë ït sprëäds fürthër ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.disaster.storm.title": "⟦Wïntër Störm ΞΞΞΞ⟧",
  "event.disaster.storm.body": "⟦Ä brütäl störm bättërs thë vïllägë. Rööfs änd störës älïkë täkë dämägë. ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.disaster.storm.choice.shelter": "⟦Shëltër ïn pläcë änd wäït ït öüt ΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.disaster.storm.choice.spend-reserves": "⟦Spënd tïmbër rësërvës shörïng üp thë wörst-hït hömës ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.disaster.fire.title": "⟦Wörkshöp Fïrë ΞΞΞΞ⟧",
  "event.disaster.fire.body": "⟦Än ünättëndëd förgë sëts ä wörkshöp äbläzë. Dïscöntënt mäkës äccïdënts lïkë thïs mörë cömmön. ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.disaster.fire.choice.let-burn": "⟦Lët ït bürn öüt — nöt wörth thë rïsk fïghtïng ït ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.disaster.fire.choice.bucket-line": "⟦Örgänïsë ä bückët lïnë tö sävë whät's lëft ΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.era.first-tech.title": "⟦Ä Nëw Ägë öf Lëärnïng ΞΞΞΞΞΞΞ⟧",
  "event.era.first-tech.body": "⟦Thë rëälm's fïrst trüë ïnnövätïön sprëäds thröügh thë vïllägës. ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.era.first-tech.choice.celebrate": "⟦Dëclärë ä däy öf cëlëbrätïön ΞΞΞΞΞΞΞΞΞ⟧",
  "event.era.prosperity.title": "⟦Än Ägë öf Pröspërïty ΞΞΞΞΞΞ⟧",
  "event.era.prosperity.body": "⟦Thë trëäsüry swëlls bëyönd änythïng thë rëälm häs sëën bëförë. ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.era.prosperity.choice.public-works": "⟦Fünd püblïc wörks ΞΞΞΞΞΞ⟧",
  "event.era.prosperity.choice.hoard": "⟦Höärd thë sürplüs ΞΞΞΞΞΞ⟧",
  "event.era.tercentenary.title": "⟦Ä Vïllägë Cömë öf Ägë ΞΞΞΞΞΞΞ⟧",
  "event.era.tercentenary.body": "⟦Thë sëttlëmënt häs gröwn ïntö ä trüë vïllägë, wïth äll thë ständïng thät ïmplïës. ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.era.tercentenary.choice.acknowledge": "⟦Märk thë öccäsïön ΞΞΞΞΞΞ⟧",
  "event.unrest.grumbling.title": "⟦Grümblïng ïn thë Strëëts ΞΞΞΞΞΞΞΞ⟧",
  "event.unrest.grumbling.body": "⟦Dïscöntënt ïs sprëädïng. Sömëthïng nëëds tö gïvë. ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.unrest.grumbling.choice.address": "⟦Äddrëss grïëväncës püblïcly ΞΞΞΞΞΞΞΞΞ⟧",
  "event.unrest.grumbling.choice.crackdown": "⟦Cräck döwn ön tröüblëmäkërs ΞΞΞΞΞΞΞΞΞ⟧",
  "event.unrest.strike.title": "⟦Wörkërs' Strïkë ΞΞΞΞΞ⟧",
  "event.unrest.strike.body": "⟦Läbörërs rëfüsë tö wörk üntïl cöndïtïöns ïmprövë. ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.unrest.strike.choice.concede": "⟦Cöncëdë tö thëïr dëmänds ΞΞΞΞΞΞΞΞ⟧",
  "event.unrest.strike.choice.wait-out": "⟦Wäït ït öüt ΞΞΞΞ⟧",
  "event.unrest.rumor-mongering.title": "⟦Rümör Möngërïng ΞΞΞΞΞ⟧",
  "event.unrest.rumor-mongering.body": "⟦Wïld rümörs äböüt thë kïngdöm's lëädërshïp cïrcülätë ämöng thë dïscöntëntëd. ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.unrest.rumor-mongering.choice.counter": "⟦Cöüntër thë rümörs öpënly ΞΞΞΞΞΞΞΞ⟧",
  "event.unrest.rumor-mongering.choice.ignore": "⟦Ïgnörë ït — ït'll päss ΞΞΞΞΞΞΞ⟧",
  "event.tutorial.welcome.title": "⟦Ä Wörd Fröm Yöür Stëwärd ΞΞΞΞΞΞΞΞ⟧",
  "event.tutorial.welcome.body": "⟦\"Wëlcömë, my lïëgë. Fïrsthölm ïs föündëd, büt ä vïllägë ïs nöt yët ä kïngdöm. Öpën thë Vïllägë änd Büïld pänëls — gröw yöür pöpülätïön, këëp thëm fëd, änd thë rëst föllöws. Ï'll chëck ïn äs thïngs dëvëlöp.\" ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.tutorial.welcome.choice.ack": "⟦Lëäd ön, Stëwärd. ΞΞΞΞΞΞ⟧",
  "event.tutorial.economy.title": "⟦Thë Gränärïës Ärë Füll ΞΞΞΞΞΞΞ⟧",
  "event.tutorial.economy.body": "⟦\"Wëll fëd änd gröwïng — yöür färms ärë ëärnïng thëïr këëp. Öncë wööd änd stönë flöw stëädïly töö, löök tö thë Büïld pänël's prödüctïön chäïns: säwmïlls änd wörkshöps türn räw gööds ïntö fïnïshëd önës wörth mörë.\" ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.tutorial.economy.choice.ack": "⟦Nötëd. ΞΞ⟧",
  "event.tutorial.happiness.title": "⟦Ön Cöntëntmënt ΞΞΞΞΞ⟧",
  "event.tutorial.happiness.body": "⟦\"Mïnd yöür pëöplë's jöy, my lïëgë — thë Vïllägë pänël shöws ït pläïnly. Ä häppy vïllägë päys mörë täx änd gröws fästër; lët häppïnëss sïnk änd böth cürdlë. Hövër äny nümbër yöü dön't trüst; Ï'vë mädë sürë ït ëxpläïns ïtsëlf.\" ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.tutorial.happiness.choice.ack": "⟦Ï'll këëp wätch. ΞΞΞΞΞ⟧",
  "event.tutorial.tax.title": "⟦Thë Wëïght öf thë Cröwn's Düë ΞΞΞΞΞΞΞΞΞ⟧",
  "event.tutorial.tax.body": "⟦\"Thë täx rätë ïn thë Vïllägë pänël ïs yöür shärpëst lëvër — änd yöür rïskïëst. Räïsë ït änd thë trëäsüry swëlls tödäy, büt jöy blëëds däïly, änd ä pünïtïvë rätë ëvëntüälly täxës ïtsëlf ïntö pövërty. Mödërätïön cömpöünds; grëëd döësn't.\" ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.tutorial.tax.choice.ack": "⟦Ä fäïr wärnïng. ΞΞΞΞΞ⟧",
  "event.tutorial.edicts.title": "⟦Ëdïcts öf thë Rëälm ΞΞΞΞΞΞ⟧",
  "event.tutorial.edicts.body": "⟦\"Thë trëäsüry cän bëär än ëdïct nöw, ïf yöü'd ënäct önë fröm thë Kïngdöm pänël — ëäch ïs ä ständïng bönüs wïth ä däïly üpkëëp, pläïn ïn ïts lëdgër lïnë. Hövër önë tö sëë ëxäctly whät ït chängës; nöthïng ïn thïs cöürt hïdës ïts nümbërs.\" ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.tutorial.edicts.choice.ack": "⟦Shöw më thë lëdgër. ΞΞΞΞΞΞ⟧",
  "event.tutorial.complete.title": "⟦Ä Kïngdöm, Nöt Jüst ä Vïllägë ΞΞΞΞΞΞΞΞΞ⟧",
  "event.tutorial.complete.body": "⟦\"Tïër twö, my lïëgë — fëd, shëltërëd, änd büïlt üp ön yöür öwn jüdgmënt. Thät's ä stäblë, gröwïng kïngdöm by äny Stëwärd's rëckönïng. Ëvërythïng fröm hërë ïs thë sämë cräft ät ä lärgër scälë. Wëll gövërnëd.\" ΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞΞ⟧",
  "event.tutorial.complete.choice.ack": "⟦Önwärd. ΞΞΞ⟧"
}
