// Base traits (M34; GDD §15). Each is a small, fixed skill-delta bundle
// applied once when a notable is assigned the trait (game/characters.ts) —
// clamped into the same 0..20 skill range office bonuses already read.
[
  {
    "id": "base:trait.shrewd",
    "name": "Shrewd",
    "desc": "A sharp head for figures and levies.",
    "skillModifiers": { "stewardship": 3 },
    "tags": ["economy"],
  },
  {
    "id": "base:trait.greedy",
    "name": "Greedy",
