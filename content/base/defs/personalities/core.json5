// Base AI personality archetypes (M36; GDD §11; doc 07 §9). `planBiases` keys
// are ai/planner.ts PlanArchetype ids: DevelopHeartland, ExpandSettle,
// ForgeAlliance, MilitaryBuildup, ConquestWar, TechRace (Recover is crisis-
// driven, not personality-biased, and stays out of every profile below).
[
  {
    "id": "base:personality.warmonger",
    "name": "Warmonger",
    "desc": "Sees every border as an opportunity and every rival as a future conquest.",
    "weights": {
      "expansion": 0.5, "aggression": 0.95, "economy": 0.3, "tech": 0.25,
      "diplomacyTrust": 0.15, "riskTolerance": 0.85, "grudgeRetention": 0.7, "honor": 0.3,
    },
    "preferences": {
      "favoredVictory": ["conquest"],
      "favoredUnits": ["cavalry", "infantry"],
      "buildStyle": ["fortified", "aggressive"],
      "insultThreshold": -10,
      "giftReceptivity": 0.6,
    },
    "planBiases": { "MilitaryBuildup": 1.4, "ConquestWar": 1.5, "ForgeAlliance": 0.5 },
    "taunts": {
      "warDeclared": ["Your walls will not save you.", "This land will run red before the snows come."],
      "victory": ["As it should be."],
    },
    "tags": ["martial", "hostile"],
  },
  {
    "id": "base:personality.builder",
    "name": "Builder",
    "desc": "Measures greatness in granaries and city walls raised, not battles won.",
