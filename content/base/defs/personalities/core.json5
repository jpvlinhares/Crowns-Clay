    "planBiases": { "DevelopHeartland": 1.5, "MilitaryBuildup": 0.4, "ConquestWar": 0.3 },
    "taunts": {
      "warDeclared": ["We had no wish for this."],
      "victory": ["Let the histories note what patience builds."],
    },
    "tags": ["economy", "peaceful"],
  },
  {
