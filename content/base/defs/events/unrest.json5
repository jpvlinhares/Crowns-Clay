// Unrest pool (M33; GDD App. A; §12's happiness -> unrest link). Fires when
// happiness runs low — a real cost to ignoring discontent, not just flavour.
// M44: text/choice text are locale KEYS (content/base/locale/en.json5), not
// raw display strings — see doc 06 "LocalizedText".
[
  {
    "id": "base:event.unrest.grumbling",
    "name": "Grumbling in the Streets",
    "pool": "unrest",
    "scope": "village",
    "trigger": { "stat": "village.happiness", "lt": 40 },
    "weight": 3,
    "cooldownDays": 30,
    "text": {
      "title": "event.unrest.grumbling.title",
      "body": "event.unrest.grumbling.body",
    },
    "choices": [
      {
        "id": "address",
        "text": "event.unrest.grumbling.choice.address",
        "effects": [{ "modifier": { "stat": "village.happiness", "op": "add", "value": 6 } }],
        "aiScoreHints": { "diplomacyTrust": 0.5 },
      },
      {
        "id": "crackdown",
        "text": "event.unrest.grumbling.choice.crackdown",
        "effects": [{ "modifier": { "stat": "village.happiness", "op": "add", "value": -4 } }],
        "aiScoreHints": { "aggression": 0.4 },
      },
    ],
    "tags": ["unrest"],
  },
  {
    "id": "base:event.unrest.strike",
    "name": "Workers' Strike",
    "pool": "unrest",
    "scope": "village",
    "trigger": { "stat": "village.happiness", "lt": 25 },
    "weight": 2,
    "cooldownDays": 45,
    "text": {
      "title": "event.unrest.strike.title",
      "body": "event.unrest.strike.body",
    },
    "choices": [
      {
        "id": "concede",
        "text": "event.unrest.strike.choice.concede",
        "effects": [
          { "removeResource": { "resource": "base:resource.food", "amount": 10 } },
          { "modifier": { "stat": "village.happiness", "op": "add", "value": 10 } },
        ],
        "aiScoreHints": { "economy": 0.3 },
      },
      {
        "id": "wait-out",
        "text": "event.unrest.strike.choice.wait-out",
        "effects": [{ "modifier": { "stat": "village.happiness", "op": "add", "value": -5 } }],
        "aiScoreHints": { "riskTolerance": 0.5 },
      },
    ],
    "tags": ["unrest", "labor"],
  },
  {
    "id": "base:event.unrest.rumor-mongering",
    "name": "Rumor Mongering",
    "pool": "unrest",
    "scope": "village",
    "trigger": { "all": [{ "stat": "village.happiness", "lt": 50 }, { "chance": 0.3 }] },
    "weight": 1,
    "cooldownDays": 45,
    "text": {
      "title": "event.unrest.rumor-mongering.title",
      "body": "event.unrest.rumor-mongering.body",
    },
    "choices": [
      {
        "id": "counter",
        "text": "event.unrest.rumor-mongering.choice.counter",
        "effects": [{ "modifier": { "stat": "village.happiness", "op": "add", "value": 3 } }],
        "aiScoreHints": { "diplomacyTrust": 0.4 },
      },
      {
        "id": "ignore",
        "text": "event.unrest.rumor-mongering.choice.ignore",
        "effects": [],
        "aiScoreHints": { "riskTolerance": 0.6 },
      },
    ],
    "tags": ["unrest"],
  },
]
