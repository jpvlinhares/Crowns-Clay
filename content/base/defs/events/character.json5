// Character pool (M33; GDD App. A) — a lightweight stand-in for the Character
// system's own event hooks (Characters land at M34); these fire at kingdom
// scope without naming a specific advisor, since notables aren't queryable
// from the event DSL yet.
[
  {
    "id": "base:event.character.advisor-dispute",
    "name": "Advisor Dispute",
    "pool": "character",
    "scope": "kingdom",
    "trigger": { "chance": 0.15 },
    "weight": 2,
    "cooldownDays": 60,
    "text": {
      "title": "Advisor Dispute",
      "body": "Two of the court's advisors clash publicly over policy.",
    },
    "choices": [
      {
        "id": "mediate",
        "text": "Mediate personally",
        "effects": [{ "modifier": { "stat": "village.happiness", "op": "add", "value": 2 } }],
        "aiScoreHints": { "diplomacyTrust": 0.5 },
      },
      {
        "id": "ignore",
        "text": "Let them settle it themselves",
        "effects": [{ "modifier": { "stat": "village.happiness", "op": "add", "value": -1 } }],
        "aiScoreHints": { "riskTolerance": 0.5 },
      },
    ],
    "tags": ["court"],
  },
  {
    "id": "base:event.character.local-hero",
    "name": "A Local Hero",
    "pool": "character",
    "scope": "village",
    "trigger": { "stat": "village.happiness", "gte": 70 },
    "weight": 2,
    "cooldownDays": 90,
    "text": {
      "title": "A Local Hero",
      "body": "A villager's quiet acts of generosity have become the talk of the realm.",
    },
    "choices": [
      {
        "id": "honor",
        "text": "Honor them publicly",
        "effects": [{ "modifier": { "stat": "village.happiness", "op": "add", "value": 4 } }],
        "aiScoreHints": { "economy": 0.2 },
      },
    ],
    "tags": ["notable"],
  },
  {
    "id": "base:event.character.retirement",
    "name": "Advisor Retirement",
    "pool": "character",
    "scope": "kingdom",
    "trigger": { "chance": 0.1 },
    "weight": 1,
    "cooldownDays": 180,
    "text": {
      "title": "Advisor Retirement",
      "body": "One of the court's advisors asks to step down while still in good health.",
    },
    "choices": [
      {
        "id": "grant-pension",
        "text": "Grant a modest pension",
        "requirements": { "stat": "kingdom.treasury", "gte": 10 },
        "effects": [{ "modifier": { "stat": "kingdom.treasury", "op": "add", "value": -10 } }],
        "aiScoreHints": { "diplomacyTrust": 0.4 },
      },
      {
        "id": "accept",
        "text": "Accept the retirement plainly",
        "effects": [],
        "aiScoreHints": { "economy": 0.3 },
      },
    ],
    "tags": ["court"],
  },
]
