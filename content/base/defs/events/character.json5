// Character pool (M33; GDD App. A) — a lightweight stand-in for the Character
// system's own event hooks (Characters land at M34); these fire at kingdom
// scope without naming a specific advisor, since notables aren't queryable
// from the event DSL yet.
// M44: text/choice text are locale KEYS (content/base/locale/en.json5), not
// raw display strings — see doc 06 "LocalizedText".
[
  {
    "id": "base:event.character.advisor-dispute",
    "name": "Advisor Dispute",
    "pool": "character",
    "scope": "kingdom",
    "trigger": { "chance": 0.15 },
    "weight": 2,
    "cooldownDays": 60,
    "text": {
      "title": "event.character.advisor-dispute.title",
      "body": "event.character.advisor-dispute.body",
    },
    "choices": [
      {
        "id": "mediate",
        "text": "event.character.advisor-dispute.choice.mediate",
        "effects": [{ "modifier": { "stat": "village.happiness", "op": "add", "value": 2 } }],
        "aiScoreHints": { "diplomacyTrust": 0.5 },
      },
      {
        "id": "ignore",
        "text": "event.character.advisor-dispute.choice.ignore",
        "effects": [{ "modifier": { "stat": "village.happiness", "op": "add", "value": -1 } }],
        "aiScoreHints": { "riskTolerance": 0.5 },
      },
    ],
    "tags": ["court"],
  },
  {
    "id": "base:event.character.local-hero",
    "name": "A Local Hero",
    "pool": "character",
    "scope": "village",
    "trigger": { "stat": "village.happiness", "gte": 70 },
    "weight": 2,
    "cooldownDays": 90,
    "text": {
      "title": "event.character.local-hero.title",
      "body": "event.character.local-hero.body",
    },
    "choices": [
      {
        "id": "honor",
        "text": "event.character.local-hero.choice.honor",
        "effects": [{ "modifier": { "stat": "village.happiness", "op": "add", "value": 4 } }],
        "aiScoreHints": { "economy": 0.2 },
      },
    ],
    "tags": ["notable"],
  },
  {
    "id": "base:event.character.retirement",
    "name": "Advisor Retirement",
    "pool": "character",
    "scope": "kingdom",
    "trigger": { "chance": 0.1 },
    "weight": 1,
    "cooldownDays": 180,
    "text": {
      "title": "event.character.retirement.title",
      "body": "event.character.retirement.body",
    },
    "choices": [
      {
        "id": "grant-pension",
        "text": "event.character.retirement.choice.grant-pension",
        "requirements": { "stat": "kingdom.treasury", "gte": 10 },
        "effects": [{ "modifier": { "stat": "kingdom.treasury", "op": "add", "value": -10 } }],
        "aiScoreHints": { "diplomacyTrust": 0.4 },
      },
      {
        "id": "accept",
        "text": "event.character.retirement.choice.accept",
        "effects": [],
        "aiScoreHints": { "economy": 0.3 },
      },
    ],
    "tags": ["court"],
  },
]
