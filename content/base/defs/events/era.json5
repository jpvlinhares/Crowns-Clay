// Era pool (M33; GDD App. A; §9 "era transitions raise event"). Milestone
// events tied to real tech-tree/kingdom progress rather than season/chance —
// `hasTech` ties directly into M32's research layer.
// M44: text/choice text are locale KEYS (content/base/locale/en.json5), not
// raw display strings — see doc 06 "LocalizedText".
[
  {
    "id": "base:event.era.first-tech",
    "name": "A New Age of Learning",
    "pool": "era",
    "scope": "kingdom",
    "trigger": { "hasTech": "base:tech.agriculture-t1-1" },
    "weight": 1,
    "once": true,
    "text": {
      "title": "event.era.first-tech.title",
      "body": "event.era.first-tech.body",
    },
    "choices": [
      {
        "id": "celebrate",
        "text": "event.era.first-tech.choice.celebrate",
        "effects": [{ "modifier": { "stat": "village.happiness", "op": "add", "value": 5 } }],
        "aiScoreHints": { "tech": 0.6 },
      },
    ],
    "tags": ["milestone"],
  },
  {
    "id": "base:event.era.prosperity",
    "name": "An Age of Prosperity",
    "pool": "era",
    "scope": "kingdom",
    "trigger": { "stat": "kingdom.treasury", "gte": 500 },
    "weight": 1,
    "once": true,
    "text": {
      "title": "event.era.prosperity.title",
      "body": "event.era.prosperity.body",
    },
    "choices": [
      {
        "id": "public-works",
        "text": "event.era.prosperity.choice.public-works",
        "requirements": { "stat": "kingdom.treasury", "gte": 50 },
        "effects": [
          { "modifier": { "stat": "kingdom.treasury", "op": "add", "value": -50 } },
          { "modifier": { "stat": "village.happiness", "op": "add", "value": 6 } },
        ],
        "aiScoreHints": { "economy": 0.7 },
      },
      {
        "id": "hoard",
        "text": "event.era.prosperity.choice.hoard",
        "effects": [],
        "aiScoreHints": { "riskTolerance": 0.5 },
      },
    ],
    "tags": ["milestone"],
  },
  {
    "id": "base:event.era.tercentenary",
    "name": "A Village Come of Age",
    "pool": "era",
    "scope": "village",
    "trigger": { "stat": "village.tier", "gte": 2 },
    "weight": 1,
    "once": true,
    "text": {
      "title": "event.era.tercentenary.title",
      "body": "event.era.tercentenary.body",
    },
    "choices": [
      {
        "id": "acknowledge",
        "text": "event.era.tercentenary.choice.acknowledge",
        "effects": [{ "modifier": { "stat": "village.happiness", "op": "add", "value": 4 } }],
        "aiScoreHints": { "expansion": 0.5 },
      },
    ],
    "tags": ["milestone"],
  },
]
