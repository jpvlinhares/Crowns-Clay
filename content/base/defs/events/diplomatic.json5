    },
    "choices": [
      {
        "id": "apologize",
        "text": "event.diplomatic.border-incident.choice.apologize",
        "effects": [{ "opinionChange": { "delta": 5 } }],
        "aiScoreHints": { "diplomacyTrust": 0.6 },
      },
      {
        "id": "expel",
        "text": "event.diplomatic.border-incident.choice.expel",
        "effects": [{ "opinionChange": { "delta": -10 } }],
        "aiScoreHints": { "aggression": 0.5 },
      },
    ],
    "tags": ["border"],
  },
