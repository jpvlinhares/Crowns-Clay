// Diplomatic pool (M33; GDD App. A) — `opinionChange` applies a blanket delta
// between this event's kingdom and every OTHER kingdom it has contact with
// (an optional hook, game/events.ts; inert — no-op — without one wired, same
// pattern M23/M30/M31/M32 use for their own optional cross-module context).
[
  {
    "id": "base:event.diplomatic.border-incident",
    "name": "Border Incident",
    "pool": "diplomatic",
    "scope": "kingdom",
    "trigger": { "chance": 0.2 },
    "weight": 2,
    "cooldownDays": 60,
    "text": {
      "title": "Border Incident",
      "body": "Herders from a neighbouring realm are caught grazing on disputed land.",
    },
    "choices": [
      {
        "id": "apologize",
        "text": "Apologize and let it go",
        "effects": [{ "opinionChange": { "delta": 5 } }],
        "aiScoreHints": { "diplomacyTrust": 0.6 },
      },
      {
        "id": "expel",
        "text": "Expel them by force",
        "effects": [{ "opinionChange": { "delta": -10 } }],
        "aiScoreHints": { "aggression": 0.5 },
      },
    ],
    "tags": ["border"],
  },
  {
    "id": "base:event.diplomatic.royal-envoy",
    "name": "Royal Envoy",
    "pool": "diplomatic",
    "scope": "kingdom",
    "trigger": { "chance": 0.15 },
    "weight": 2,
    "cooldownDays": 90,
    "text": {
      "title": "Royal Envoy",
      "body": "A neighbouring court sends an envoy bearing gifts and good will.",
    },
    "choices": [
      {
        "id": "welcome",
        "text": "Welcome them warmly",
        "effects": [
          { "opinionChange": { "delta": 8 } },
          { "modifier": { "stat": "village.happiness", "op": "add", "value": 2 } },
        ],
        "aiScoreHints": { "diplomacyTrust": 0.7 },
      },
      {
        "id": "cool-reception",
        "text": "Receive them coolly",
        "effects": [{ "opinionChange": { "delta": -2 } }],
        "aiScoreHints": { "riskTolerance": 0.3 },
      },
    ],
    "tags": ["envoy"],
  },
  {
    "id": "base:event.diplomatic.trade-dispute",
    "name": "Trade Dispute",
    "pool": "diplomatic",
    "scope": "kingdom",
    "trigger": { "all": [{ "hasEdict": "base:edict.corvee-labor" }, { "chance": 0.5 }] },
    "weight": 1,
    "cooldownDays": 90,
    "text": {
      "title": "Trade Dispute",
      "body": "Neighbouring merchants complain the corvée levies are disrupting trade routes.",
    },
    "choices": [
      {
        "id": "concede",
        "text": "Hear their complaint out",
        "effects": [{ "opinionChange": { "delta": 3 } }],
        "aiScoreHints": { "diplomacyTrust": 0.5 },
      },
      {
        "id": "dismiss",
        "text": "Dismiss the complaint",
        "effects": [{ "opinionChange": { "delta": -5 } }],
        "aiScoreHints": { "economy": 0.4 },
      },
    ],
    "tags": ["trade"],
  },
]
