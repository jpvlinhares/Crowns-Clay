  { "id": "base:resource.wood", "name": "Wood", "tier": "raw", "category": "material", "basePrice": 2, "weight": 2 },
  { "id": "base:resource.stone", "name": "Stone", "tier": "raw", "category": "material", "basePrice": 3, "weight": 4 },
  { "id": "base:resource.food", "name": "Food", "tier": "raw", "category": "food", "basePrice": 1, "weight": 1, "decay": 0.03 },
  { "id": "base:resource.planks", "name": "Planks", "tier": "processed", "category": "material", "basePrice": 5, "weight": 1.5 },
  { "id": "base:resource.tools", "name": "Tools", "tier": "finished", "category": "material", "basePrice": 12, "weight": 1 },
]
