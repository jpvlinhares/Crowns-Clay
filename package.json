{
  "name": "crowns-and-clay",
  "private": true,
  "version": "0.1.0",
  "description": "Crowns & Clay — browser-based medieval kingdom management game (see docs/design)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run gen:content && tsc -b",
    "typecheck": "tsc -b --dry || tsc -b",
    "test": "npm run build && node --test \"packages/*/dist/**/*.test.js\"",
    "lint": "eslint .",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "replay:verify": "node packages/tools/dist/replay.js verify all",
    "replay:record": "node packages/tools/dist/replay.js record all",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/postinstall.mjs",
    "gen:content": "node scripts/gen-content.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "pixi.js": "^8.6.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.0.0"
  }
}
